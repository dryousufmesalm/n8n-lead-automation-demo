    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3001/api/whatsapp/send",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: $('Attach CRM').item.json.phone, message: `🔥 Hot lead: ${$('Attach CRM').item.json.name} (${$('Attach CRM').item.json.company}) — score ${$('Attach CRM').item.json.score}. Budget $${$('Attach CRM').item.json.budget_usd}.` }) }}",
        "options": {}
      },
